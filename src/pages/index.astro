---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SLOGAN } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🎮 Hello, Players!</h1>
			<p>
				Welcome to my terrible, terrible website.
			</p>
			<p>
				I'm a small game developer from Ireland making terrible games for my own entertainment. 
			</p>
			<p>
				If you want good games, leave. You won't find any here.
			</p>
			<p>
				However, if you're here for for the laugh, by all means explore my bad, very bad games.
			</p>
			<p>
				Enjoy!
			</p>
		</main>
		<Footer />
	</body>
</html>
