---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SLOGAN } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🎮 Hello, Players!</h1>
			<p>
				Welcome players to my terrible, terrible website.
			</p>
			<p>
				I'm a small game developer from Ireland making terrible games for my own entertainment. 
			</p>
			<p>
				If you want good games, leave. You won't find any here.
			</p>
			<p>
				However, if you're here for for the laugh, by all means explore my bad, very bad games.
			</p>
			<p>
				Enjoy!
			</p>
			<nav class="page-links" aria-label="Explore the site">
				<a class="page-link" href="/blog">
					<h2>🎮Games</h2>
					<p>Explore the games I've made.</p>
					<span aria-hidden="true">Explore games →</span>
				</a>
				<a class="page-link" href="/devlog">
					<h2>📜Devlogs</h2>
					<p>Follow along with how they're made.</p>
					<span aria-hidden="true">Read devlogs →</span>
				</a>
			</nav>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		width: min(960px, calc(100vw - 2rem));
		margin-top: 2rem;
		position: relative;
		left: 50%;
		transform: translateX(-50%);
	}

	.page-link {
		display: block;
		box-sizing: border-box;
		min-height: 190px;
		padding: 1.75rem 2rem;
		border: 1px solid rgb(var(--gray-light));
		border-top: 5px solid var(--accent);
		border-radius: 12px;
		background: color-mix(in srgb, var(--accent) 6%, var(--surface));
		box-shadow: 0 8px 24px rgba(var(--black), 0.12);
		color: inherit;
		text-decoration: none;
		transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
	}

	.page-link h2 {
		margin: 0 0 0.75rem;
		font-size: 1.8rem;
	}

	.page-link p {
		margin: 0 0 0.75rem;
	}

	.page-link span {
		color: var(--accent);
		font-weight: 700;
	}

	.page-link:hover {
		transform: translateY(-4px);
		box-shadow: 0 14px 32px rgba(var(--black), 0.18);
	}

	.page-link:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 3px;
	}

	@media (max-width: 520px) {
		.page-links {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.page-link {
			min-height: 0;
			padding: 1.5rem;
		}
	}
</style>
