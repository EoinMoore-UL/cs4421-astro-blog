---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SLOGAN } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🧑‍🚀 Hello, Players!</h1>
			<p>
				This site aims to be an easy way of creating characters for your next DnD adventure.
			</p>
			<p>
				Choose your character's:
				<ul>
					<li><code>Class</code> at any level,</li>
					<li><code>Background</code> and <code>Race</code></li>
					<li>and their <code>tragic backstory!</code></li>
				</ul>
			</p>
		</main>
		<Footer />
	</body>
</html>
