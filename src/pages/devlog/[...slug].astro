---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import DevlogPost from '../../layouts/DevlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('devlogs');
	const authors = await getCollection('authors');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: {
			...post,
			author: authors.find((author) => author.id === post.data.author)?.data,
		},
	}));
}

type Props = CollectionEntry<'devlogs'> & {
	author?: CollectionEntry<'authors'>['data'];
};

const post = Astro.props;
const { Content } = await render(post);
---

<DevlogPost {...post.data} author={post.author}>
	<Content />
</DevlogPost>
