---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	author: CollectionEntry<'authors'>['data'];
}

const { author } = Astro.props;
---

<section class="author-profile" aria-labelledby="author-heading">
	<Image class="avatar" src={author.avatar} width={96} height={96} alt={`${author.name}'s avatar`} />
	<div>
		<h2 id="author-heading">About {author.name}</h2>
		<p>{author.bio}</p>
		<nav aria-label={`${author.name}'s social links`}>
			<ul>
				{author.socials.map((social) => (
					<li><a href={social.url} rel="me">{social.label}</a></li>
				))}
			</ul>
		</nav>
	</div>
</section>

<style>
	.author-profile {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.avatar {
		flex: 0 0 auto;
		border-radius: 50%;
		object-fit: cover;
	}
	h2 {
		margin: 0 0 0.5rem;
		font-size: 1.25rem;
	}
	p {
		margin: 0 0 0.75rem;
	}
	ul {
		display: flex;
		gap: 1rem;
		padding: 0;
		margin: 0;
		list-style: none;
	}
	@media (max-width: 480px) {
		.author-profile {
			flex-direction: column;
		}
	}
</style>